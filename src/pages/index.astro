---
import IndexLayout from '@/layouts/IndexLayout.astro'
import About from '@/components/widgets/About.astro'
import PostList from '@/components/widgets/PostList.astro'
import { themeConfig } from '@/config'
import { getSortedFilteredPosts } from '@/utils/draft'
import { personJsonLd } from '@/utils/seo'
import SocialLink from '@/components/ui/SocialLink.astro'

const posts = await getSortedFilteredPosts()
const workPosts = posts.filter((post) => post.data.logType === 'work')
const readingPosts = posts.filter((post) => post.data.logType === 'reading')
---

<IndexLayout
  title={themeConfig.site.title}
  description={themeConfig.site.description}
  jsonLd={personJsonLd}
>
  <About />
  <SocialLink />

  <main>
    <details id="work" class="log-section">
      <summary class="section-heading">
        <span class="chevron" aria-hidden="true"></span>
        <span class="label">work</span>
        <span class="count">{workPosts.length}</span>
      </summary>
      <div class="section-body">
        <PostList posts={workPosts.slice(0, 3)} meta="date" />
        <a class="more-link" href="/work/">show me more</a>
      </div>
    </details>

    <details id="writing" class="log-section">
      <summary class="section-heading">
        <span class="chevron" aria-hidden="true"></span>
        <span class="label">writing</span>
        <span class="count">{readingPosts.length}</span>
      </summary>
      <div class="section-body">
        <PostList posts={readingPosts.slice(0, 3)} meta="date" />
        <a class="more-link" href="/writing/">show me more</a>
      </div>
    </details>
  </main>
</IndexLayout>

<script is:inline define:vars={{ sectionIds: ['work', 'writing'] }}>
  // Deep links like /#work should expand their section
  function openSectionFromHash() {
    const id = location.hash.slice(1)
    if (sectionIds.includes(id)) {
      const el = document.getElementById(id)
      if (el) el.open = true
    }
  }
  document.addEventListener('astro:page-load', () => {
    openSectionFromHash()
    window.addEventListener('hashchange', openSectionFromHash)
  })
</script>

<style>
  .log-section {
    margin-top: 1.1rem;
  }

  /* Header matches a list row's size so the accordion stays quiet */
  .section-heading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.5rem;
    font-size: 0.9375rem;
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color 0.15s ease-out;
  }

  .section-heading::-webkit-details-marker {
    display: none;
  }

  .section-heading:hover {
    color: var(--text-secondary);
  }

  /* CSS triangle instead of a text glyph — stays aligned at any size */
  .chevron {
    flex-shrink: 0;
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 5px solid var(--text-tertiary);
    transition: transform 0.2s ease-out;
    transform-origin: 35% 50%;
  }

  details[open] .chevron {
    transform: rotate(90deg);
  }

  .label {
    flex: 1 1 auto;
  }

  .count {
    font-size: var(--font-size-s);
    font-weight: var(--font-weight-regular);
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .section-body {
    margin-top: 0.25rem;
    /* align rows with the heading text (past the chevron + gap) */
    padding-left: 0.95rem;
    animation: reveal 0.25s ease-out;
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .more-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: color 0.15s ease-out, text-decoration-color 0.15s ease-out;
  }

  .more-link:hover {
    color: var(--text-primary);
    text-decoration-color: var(--text-tertiary);
  }
</style>
