---
import { getSortedFilteredPosts } from '@/utils/draft'
import { tagSlug } from '@/utils/seo'
import IndexLayout from '@/layouts/IndexLayout.astro'
import { themeConfig } from '@/config'

const posts = await getSortedFilteredPosts()

const counts = new Map<string, { name: string; count: number }>()
for (const post of posts) {
  for (const tag of post.data.tags) {
    const slug = tagSlug(tag)
    const entry = counts.get(slug) ?? { name: tag, count: 0 }
    entry.count += 1
    counts.set(slug, entry)
  }
}
const tags = Array.from(counts.entries()).sort(
  ([a, x], [b, y]) => y.count - x.count || a.localeCompare(b)
)
---

<IndexLayout
  title={`Tags · ${themeConfig.site.title}`}
  description={`Browse posts by topic — computer vision, remote sensing, Earth observation and geospatial data science.`}
>
  <main>
    <h1 class="page-heading">tags</h1>
    <ul class="tag-cloud">
      {
        tags.map(([slug, t]) => (
          <li>
            <a href={`/tags/${slug}/`}>
              #{t.name} <span class="count">{t.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</IndexLayout>

<style>
  .page-heading {
    font-size: 1.5rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0 0 2rem;
  }

  .tag-cloud {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }

  .tag-cloud a {
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 2.1;
    text-transform: lowercase;
  }

  .tag-cloud a:hover {
    text-decoration: underline;
    text-decoration-color: var(--text-tertiary);
    text-underline-offset: 3px;
  }

  .count {
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }
</style>
