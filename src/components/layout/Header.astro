---
import { themeConfig } from '@/config'
import ThemeToggle from '@/components/ui/ThemeToggle.astro'
---

<header>
  <nav>
    <a class="site-title" href="/" aria-label={`${themeConfig.site.title} — home`}>
      <h1>{themeConfig.site.title}</h1>
    </a>

    {themeConfig.general.themeToggle && <ThemeToggle />}
  </nav>
</header>
<style>
  header {
    margin: 0;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .site-title {
    text-decoration: none;
  }

  .site-title h1 {
    margin: 0;
    font-size: inherit;
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
  }
</style>
