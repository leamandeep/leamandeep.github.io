<!--
  Critical style block to prevent flashing on page load in dark mode.
  Injected into the <head> before the main stylesheets, plus the inline
  script that applies the stored/system theme before first paint.
-->
<style is:inline>
  :root {
    --bg: #f6f6f4;
  }

  html.dark {
    --bg: #1b1b1b;
  }

  html {
    background-color: var(--bg);
    color-scheme: light;
  }

  html.dark {
    color-scheme: dark;
  }
</style>
<script is:inline>
  ;(function () {
    const STORAGE_KEY = 'chiri-theme'
    const root = document.documentElement
    const darkQuery = window.matchMedia('(prefers-color-scheme: dark)')

    const getStoredTheme = () => {
      try {
        return localStorage.getItem(STORAGE_KEY)
      } catch {
        return null
      }
    }

    const getSystemTheme = () => (darkQuery.matches ? 'dark' : 'light')

    const getEffectiveTheme = () => getStoredTheme() || getSystemTheme()

    function applyTheme(theme) {
      root.classList.remove('light', 'dark')
      root.classList.add(theme)

      document.dispatchEvent(
        new CustomEvent('themechange', {
          detail: { theme, isUserChoice: getStoredTheme() !== null }
        })
      )
    }

    window.ThemeManager = {
      STORAGE_KEY,

      toggle() {
        const next = root.classList.contains('dark') ? 'light' : 'dark'
        try {
          localStorage.setItem(STORAGE_KEY, next)
        } catch (e) {
          console.warn('Failed to store theme preference:', e)
        }
        applyTheme(next)
      },

      getEffectiveTheme
    }

    // Apply before first paint (script is in <head>, runs synchronously)
    applyTheme(getEffectiveTheme())

    // Follow system changes unless the user made an explicit choice
    darkQuery.addEventListener('change', () => {
      if (!getStoredTheme()) applyTheme(getSystemTheme())
    })

    // Re-apply after client-side navigation (the swapped document carries the build-time class)
    const reapply = () => requestAnimationFrame(() => applyTheme(getEffectiveTheme()))
    document.addEventListener('astro:after-swap', reapply)
    document.addEventListener('astro:page-load', reapply)
  })()
</script>
