---
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '@/utils/date'

interface Props {
  posts: CollectionEntry<'posts'>[]
  /** 'day' shows just the day number (month comes from the group heading); 'date' shows the full date */
  meta?: 'date' | 'day'
  /** Group rows under month headings, like navthings.github.io */
  groupByMonth?: boolean
  /** Staggered fade-in of rows on page load (archive pages) */
  stagger?: boolean
}

const { posts, meta = 'date', groupByMonth = false, stagger = false } = Astro.props as Props

let rowIndex = 0

const MONTHS = [
  'january',
  'february',
  'march',
  'april',
  'may',
  'june',
  'july',
  'august',
  'september',
  'october',
  'november',
  'december'
]

const sorted = [...posts].sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())

type Group = { label: string; posts: CollectionEntry<'posts'>[] }

const groups: Group[] = []
if (groupByMonth) {
  const byMonth = new Map<string, Group>()
  for (const post of sorted) {
    const date = post.data.publishDate
    const key = `${date.getFullYear()}-${date.getMonth()}`
    let group = byMonth.get(key)
    if (!group) {
      group = { label: MONTHS[date.getMonth()], posts: [] }
      byMonth.set(key, group)
      groups.push(group)
    }
    group.posts.push(post)
  }
} else {
  groups.push({ label: '', posts: sorted })
}

function metaText(post: CollectionEntry<'posts'>): string {
  const date = post.data.publishDate
  return meta === 'day' ? String(date.getDate()).padStart(2, '0') : formatDate(date)
}
---

<div class="post-log">
  {
    groups.map((group) => (
      <div class="group">
        {group.label && <h3 class="group-heading">{group.label}</h3>}
        <ul>
          {group.posts.map((post) => (
            <li class={stagger ? 'row-in' : undefined} style={stagger ? `--i: ${rowIndex++}` : undefined}>
              <a href={`/${post.id}/`}>
                <span class="title">{post.data.title}</span>
                <time class="meta" datetime={post.data.publishDate.toISOString().slice(0, 10)}>
                  {metaText(post)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .post-log {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .group-heading {
    font-size: var(--font-size-s);
    font-weight: var(--font-weight-regular);
    color: var(--text-secondary);
    margin: 0 0 0.5rem;
  }

  ul {
    padding: 0;
    margin: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  li {
    margin: 0;
    padding: 0;
  }

  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.5rem;
    align-items: center;
    column-gap: 1rem;
    min-height: 3rem;
    color: var(--text-primary);
    text-decoration: none;
    transition: opacity 0.15s ease-out;
  }

  .title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meta {
    width: 2.5rem;
    text-align: right;
    font-size: var(--font-size-s);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    margin: 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .post-log:hover a {
      opacity: 0.4;
    }

    .post-log:hover a:hover {
      opacity: 1;
    }
  }

  .row-in {
    animation: row-in 0.35s ease-out backwards;
    animation-delay: calc(var(--i, 0) * 45ms);
  }

  @media (hover: hover) and (pointer: fine) {
    .post-log:hover a {
      opacity: 0.4;
    }

    .post-log:hover a:hover {
      opacity: 1;
    }

    .post-log:hover a:hover .title {
      transform: translateX(3px);
    }

    .post-log:hover a:hover .meta {
      color: var(--text-secondary);
      opacity: 1;
    }
  }

  .title {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.9375rem;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .meta {
    font-size: var(--font-size-s);
    margin: 0;
    color: var(--text-secondary);
    opacity: 0.75;
    flex-shrink: 0;
    white-space: nowrap;
    letter-spacing: var(--spacing-s);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
